{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "clean-dist": "rm -rf ../server/src/frontend-dist/",
    "mv-html-to-ejs": "mv ../server/src/frontend-dist/index.html ../server/src/frontend-dist/index.ejs",
    "build": "npm run clean-dist && tsc -b && vite build",
    "dev-with-server": "npm run clean-dist && tsc -b --watch & vite build --watch"
  },
  "dependencies": {
    "@common/core": "file:../common",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@mui/material": "^9.5.0",
    "blurhash": "^2.0.5",
    "lodash": "^4.17.21",
    "motion": "^14.3.0",
    "posthog-js": "^1.396.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.10.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.21",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "canvas": "^3.2.1",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.3.4",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1"
  }
